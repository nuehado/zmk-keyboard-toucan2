/*
 * Toucan 2 — your Corne layout ported to its 42-key matrix.
 * Your board is the 36-key build: the outer pinky column has no switches, so the
 * first & last slot of each main row is &none padding (dead positions).
 * Board / shield / trackpad / modules all come from beekeeb's zmk-keyboard-toucan2;
 * only this keymap + a 2-line trackpad edit in toucan.dtsi are yours.
 *
 * (Derived from) Corne 36-key (5-column) — ported from a Miryoku layout for ZMK Studio.
 *
 * Split of labor:
 *   - Move plain keys around LIVE in ZMK Studio (the &kp positions).
 *   - Tune the mod-tap / layer-tap timings HERE in this file (see behaviors block).
 *
 * NOTE: once you start managing the keymap in Studio, edits to this file won't
 * apply until you use "Restore Stock Settings" in Studio. Adding new empty
 * "reserved" layers is the sanctioned exception.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices — used by &mo / &ltp / &to below. Studio shows the display-names.
#define BASE  0
#define BTN   1
#define NAV   2
#define MOUSE 3
#define MEDIA 4
#define NUM   5
#define SYM   6
#define FUN   7
#define GAME  8
#define GAME2 9

/ {

    behaviors {
        /*
         * Bottom-row mod-tap: hold = modifier, tap = key.
         * Miryoku baseline reproduced exactly: tap-preferred, 200 ms.
         * This is your "deep control" surface — tune it here:
         *   flavor: "tap-preferred" | "balanced" | "hold-preferred"
         *   tapping-term-ms: lower = mods trigger sooner
         *   quick-tap-ms: tap-then-hold within N ms repeats the TAP (good for
         *                 holding a letter to repeat it)
         *   require-prior-idle-ms: suppress the hold if you were just typing
         *                          (biggest single win against HRM misfires)
         */
        hm: bottom_row_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Layer-tap: hold = momentary layer, tap = key. Same Miryoku baseline.
         * Tune independently from the mods above.
         */
        ltp: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;          // tap, then hold within 200ms → repeats the tap (hold-to-delete on Bspc/Del)
            // require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Enter/exit the Gaming layer. key-positions 40 & 41 are the two
        // right-hand thumb keys — your right hand is on the mouse while
        // gaming, so these never fire by accident in-game. Press both
        // together to toggle in; press both together again to toggle out.
        // Restricted to Base + Game so stray thumb presses on other layers
        // can't flip it. (Position numbers: top row 0-9, middle 10-19,
        // bottom 20-29, thumbs 30-35 left-to-right.)
        combo_game {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&tog GAME>;
            layers = <BASE GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &none
                &none  &ltp BTN Z  &hm LALT X  &hm LCTRL C  &hm LSHFT V  &hm LGUI B  &hm LGUI N  &hm LSHFT M  &hm LCTRL COMMA  &hm LALT DOT  &ltp BTN SLASH  &none
                                    &ltp MEDIA ESC  &ltp NAV TAB  &ltp MOUSE SPACE  &ltp SYM BSPC  &ltp NUM RET  &ltp FUN DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
                &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
                &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
                                    &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &none  &bootloader  &none  &none  &to BASE  &none  &kp INS  &kp HOME  &kp UP  &kp END  &kp PG_UP  &none
                &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &caps_word  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none
                &none  &kp LALT  &kp RALT  &kp LCTRL  &kp LSHFT  &kp LGUI  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &none
                                    &none  &none  &none  &kp RET  &kp BSPC  &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none  &bootloader  &none  &none  &to BASE  &none  &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
                &none  &none  &kp RALT  &to SYM  &to MOUSE  &none  &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                    &none  &none  &none  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &none  &bootloader  &none  &none  &to BASE  &studio_unlock  &none  &none  &none  &none  &none  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &ext_power EP_TOG  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
                &none  &none  &kp RALT  &to FUN  &to MEDIA  &none  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
                                    &none  &none  &none  &kp C_STOP  &kp C_PP  &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &none  &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT  &none  &to BASE  &none  &none  &bootloader  &none
                &none  &kp SEMI  &kp N4  &kp N5  &kp N6  &kp EQUAL  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
                &none  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH  &none  &to NUM  &to NAV  &kp RALT  &none  &none
                                    &kp DOT  &kp N0  &kp MINUS  &none  &none  &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &none  &kp SQT  &kp DQT  &kp CARET  &kp BSLH  &kp GRAVE  &kp LBKT  &kp LT  &kp EQUAL  &kp GT  &kp RBKT  &none
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp AMPS  &kp LBRC  &kp LPAR  &kp PIPE  &kp RPAR  &kp RBRC  &none
                &none  &kp PRCNT  &kp SLASH  &kp MINUS  &kp PLUS  &kp ASTRK  &kp UNDER  &none  &none  &none  &none  &none
                                    &none  &none  &none  &none  &none  &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN  &none  &to BASE  &none  &none  &bootloader  &none
                &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
                &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &none  &to FUN  &to MEDIA  &kp RALT  &none  &none
                                    &kp K_APP  &kp SPACE  &kp TAB  &none  &none  &none
            >;
        };

        // GAMING (Satisfactory) — shifted one column RIGHT for ergonomics: your left
        // hand rests on the E/S/D/F keys but they still send W/A/S/D, so no in-game
        // rebinding. Outer-left column is Esc/Tab/Shift (sprint under the pinky). P, ;
        // and / fell off the right edge — none are Satisfactory binds. Left Ctrl sits on
        // the 2nd-column bottom key (build snap / mass-dismantle; crouch stays on C).
        // Thumbs: Game2 · Right Alt · Space | Backspace · Enter · Left Alt. Right Alt is
        // on the LEFT thumb so you hold it and scroll your mouse/trackpad to cycle
        // hotbars (also RAlt + click = ping); Left Alt on the right thumb saves to hotbar.
        game_layer {
            display-name = "Game";
            bindings = <
                &none  &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &none
                &none  &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &none
                &none  &kp LSHFT  &kp LCTRL  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &none
                                    &mo GAME2  &kp RALT  &kp SPACE  &kp BSPC  &kp RET  &kp LALT
            >;
        };

        // GAME2 — momentary, HELD via &mo from the Game layer (inner-left thumb).
        // Left hand = hotbar 1-0 (tap a slot; right hand can stay on the mouse).
        // Right hand = nudge cluster for fine-placing a locked hologram (lock with
        // H first): inverted-T arrows + Page Up/Down for vertical nudge. Hold the
        // right-thumb Ctrl for 0.5 m half-nudges. Left bottom row + left thumbs are
        // &trans, so Shift/Ctrl/Space and the Alt/RCtrl thumbs pass through while held.
        game2_layer {
            display-name = "Game2";
            bindings = <
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none  &none  &kp UP  &none  &kp PG_UP  &none
                &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none
                &none  &trans  &trans  &trans  &trans  &trans  &none  &none  &none  &none  &none  &none
                                    &trans  &trans  &trans  &trans  &kp LCTRL  &trans
            >;
        };

        // Empty layer reserved for you to fill in live from ZMK Studio.
        extra1 { status = "reserved"; };
    };
};
